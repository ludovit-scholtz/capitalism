# Required secrets for secure non-Development startup
# Note: SSL Mode=Disable is for local container development only; use TLS-enabled DB settings in staging/production.

# Game API (projects/Api)
ConnectionStrings__GameCatalog=Host=localhost;Port=5432;Database=game1;Username=postgres;Password=REPLACE_WITH_REAL_SECRET;SSL Mode=Disable
Jwt__SigningKey=set-via-secrets-manager
# Required when Auth__PasswordAuthEnabled=true; see README security section: https://github.com/ludovit-scholtz/capitalism#security-configuration
SeedData__AdminPassword=set-via-secrets-manager

# Master API (projects/MasterApi)
ConnectionStrings__MasterCatalog=Host=localhost;Port=5432;Database=gamemaster;Username=postgres;Password=REPLACE_WITH_REAL_SECRET;SSL Mode=Disable
GameAdministration__RootAdministratorEmails__0=admin@example.com
# Add additional root admins with indexed suffixes:
# GameAdministration__RootAdministratorEmails__1=second-admin@example.com

# JWT session revocation
# Both APIs persist revoked JWT IDs and active-session metadata in their primary DB catalogs.
# Optional override for shorter cleanup cadence in custom deployments:
# JwtSessionRevocation__CleanupIntervalMinutes=15
