{
  "ConnectionStrings": {
    "GameCatalog": "__SET_IN_ENV__"
  },
  "Cors": {
    "_Comment": "In non-Development environments set explicit allowed origins here (example: https://app.example.com). If empty, all cross-origin requests are rejected.",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "https://capitalism.biatec.io",
      "https://*.capitalism.biatec.io"
    ]
  },
  "Auth": {
    "PasswordAuthEnabled": false,
    "MaxFailedLoginAttempts": 5,
    "LockoutWindowMinutes": 15,
    "RateLimitRequestsPerMinute": 10
  },
  "ReverseProxy": {
    "_Comment": "Set ForwardedForHopCount > 0 and list trusted proxy IPs/CIDRs to honor X-Forwarded-For safely. Keep hop count 0 or TrustedProxies empty to disable forwarded-header processing.",
    "ForwardedForHopCount": 0,
    "TrustedProxies": []
  },
  "GraphQL": {
    "MaxDepth": 10,
    "MaxComplexity": 1000,
    "MaxPageSize": 100
  },
  "Jwt": {
    "Issuer": "Capitalism",
    "Audience": "Capitalism",
    "ExpiresMinutes": 120
  },
  "BiatecOidc": {
    "Enabled": true,
    "Authority": "https://google.biatec.io",
    "Issuer": "https://google.biatec.io",
    "Audience": "capitalism",
    "RequireHttpsMetadata": false
  },
  "SeedData": {
    "AdminEmail": "admin@example.com",
    "AdminDisplayName": "Platform Admin",
    "AdminPassword": "__SET_IN_ENV__",
    "TickIntervalSeconds":  10
  },
  "Vapid": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@events.local"
  },
  "MasterServer": {
    "RegistrationEnabled": true,
    "TelemetryEnabled": true,
    "ApiUrl": "https://localhost:44364/graphql",
    "RegistrationKey": "local-master-registration-key",
    "ServerKey": "capitalism-local",
    "DisplayName": "Capitalism Local Server",
    "Description": "Local development shard for the Capitalism simulation.",
    "Region": "eu-central-local",
    "Environment": "development",
    "BackendUrl": "https://localhost:44364",
    "FrontendUrl": "http://localhost:5173",
    "GraphqlUrl": "https://localhost:44364/graphql",
    "HeartbeatIntervalSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning"
    }
  },
  "AllowedHosts": "*"
}
