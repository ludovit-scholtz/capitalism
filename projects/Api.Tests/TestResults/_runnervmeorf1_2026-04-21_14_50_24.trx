      Executed DbCommand (1ms) [Parameters=[@cityIdList1='?' (DbType = Guid), @cityIdList2='?' (DbType = Guid), @cityIdList3='?' (DbType = Guid), @cityIdList4='?' (DbType = Guid), @cityIdList5='?' (DbType = Guid), @cityIdList6='?' (DbType = Guid), @cityIdList7='?' (DbType = Guid), @cityIdList8='?' (DbType = Guid), @cityIdList9='?' (DbType = Guid), @cityIdList10='?' (DbType = Guid), @currentTick='?' (DbType = Int64)], CommandType='Text', CommandTimeout='30']
      SELECT "c3"."CityId", "c3"."Tick", "c3"."SolarPercent", "c3"."WindPercent"
      FROM (
          SELECT "c"."CityId"
          FROM "CityWeatherForecasts" AS "c"
          WHERE "c"."CityId" IN (@cityIdList1, @cityIdList2, @cityIdList3, @cityIdList4, @cityIdList5, @cityIdList6, @cityIdList7, @cityIdList8, @cityIdList9, @cityIdList10) AND "c"."Tick" &gt;= @currentTick
          GROUP BY "c"."CityId"
      ) AS "c1"
      LEFT JOIN (
          SELECT "c2"."CityId", "c2"."Tick", "c2"."SolarPercent", "c2"."WindPercent"
          FROM (
              SELECT "c0"."CityId", "c0"."Tick", "c0"."SolarPercent", "c0"."WindPercent", ROW_NUMBER() OVER(PARTITION BY "c0"."CityId" ORDER BY "c0"."Tick") AS "row"
              FROM "CityWeatherForecasts" AS "c0"
              WHERE "c0"."CityId" IN (@cityIdList1, @cityIdList2, @cityIdList3, @cityIdList4, @cityIdList5, @cityIdList6, @cityIdList7, @cityIdList8, @cityIdList9, @cityIdList10) AND "c0"."Tick" &gt;= @currentTick
          ) AS "c2"
          WHERE "c2"."row" &lt;= 1
      ) AS "c3" ON "c1"."CityId" = "c3"."CityId"
