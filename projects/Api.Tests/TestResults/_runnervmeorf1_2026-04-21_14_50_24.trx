      SELECT "c3"."CityId", "c3"."Tick", "c3"."SolarPercent", "c3"."WindPercent"
      FROM (
          SELECT "c"."CityId"
          FROM "CityWeatherForecasts" AS "c"
          WHERE "c"."CityId" IN (@cityIdList1, @cityIdList2, @cityIdList3, @cityIdList4, @cityIdList5, @cityIdList6, @cityIdList7, @cityIdList8, @cityIdList9, @cityIdList10) AND "c"."Tick" &gt;= @currentTick
