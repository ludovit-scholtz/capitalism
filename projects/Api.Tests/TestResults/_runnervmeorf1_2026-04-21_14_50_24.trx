      SELECT "c3"."CityId", "c3"."Tick", "c3"."SolarPercent", "c3"."WindPercent"
      FROM (
          SELECT "c"."CityId"
          FROM "CityWeatherForecasts" AS "c"
          WHERE "c"."CityId" IN (@cityIdList1, @cityIdList2, @cityIdList3, @cityIdList4, @cityIdList5, @cityIdList6, @cityIdList7, @cityIdList8, @cityIdList9, @cityIdList10, @cityIdList11, @cityIdList12, @cityIdList13, @cityIdList14, @cityIdList15, @cityIdList16, @cityIdList17, @cityIdList18, @cityIdList19, @cityIdList20) AND "c"."Tick" &gt;= @currentTick
          GROUP BY "c"."CityId"
      ) AS "c1"
      LEFT JOIN (
          SELECT "c2"."CityId", "c2"."Tick", "c2"."SolarPercent", "c2"."WindPercent"
