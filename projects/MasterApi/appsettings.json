{
  "ConnectionStrings": {
    "MasterCatalog": "__SET_IN_ENV__"
  },
  "Cors": {
    "_Comment": "In non-Development environments set explicit allowed origins here (example: https://app.example.com). If empty, all cross-origin requests are rejected.",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175"
    ]
  },
  "Auth": {
    "PasswordAuthEnabled": false,
    "MaxFailedLoginAttempts": 5,
    "LockoutWindowMinutes": 15,
    "RateLimitRequestsPerMinute": 10,
    "ForgotPasswordMaxRequests": 3,
    "ForgotPasswordWindowMinutes": 15,
    "PasswordResetTokenLifetimeMinutes": 60,
    "PasswordResetFrontendUrl": "http://localhost:5173",
    "PasswordResetEmailFrom": "no-reply@capitalism.local",
    "PasswordResetEmailFromName": "Capitalism",
    "PasswordResetSmtpHost": "",
    "PasswordResetSmtpPort": 587,
    "PasswordResetSmtpUsername": "",
    "PasswordResetSmtpPassword": "",
    "PasswordResetSmtpEnableSsl": true
  },
  "GraphQL": {
    "MaxDepth": 10,
    "MaxComplexity": 1000,
    "MaxPageSize": 100
  },
  "MasterServer": {
    "RegistrationKey": "local-master-registration-key",
    "ActiveThresholdSeconds": 90
  },
  "GameAdministration": {
    "RootAdministratorEmails": []
  },
  "Jwt": {
    "Issuer": "Capitalism",
    "Audience": "Capitalism",
    "ExpiresMinutes": 120
  },
  "BiatecOidc": {
    "Enabled": true,
    "Authority": "https://google.biatec.io",
    "Issuer": "https://google.biatec.io",
    "Audience": "capitalism",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning"
    }
  },
  "AllowedHosts": "*"
}
