{
  "name": "events-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:ssr": "vite build --ssr src/entry-server.ts",
    "build:client": "vite build",
    "build-only": "run-s build:client build:ssr",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test e2e/full-journey",
    "test:e2e:full-journey": "playwright test e2e/full-journey",
    "test:e2e:archive": "playwright test e2e/archive",
    "test:e2e:docs": "playwright test e2e/docs",
    "test:e2e:video": "set VIDEO_RECORDING=true && playwright test --config playwright-video.config.ts",
    "test:security-headers": "node scripts/verify-security-headers.mjs",
    "test:screenshots": "set CI=true && playwright test --config playwright.screenshots.config.ts --ignore-snapshots e2e/docs/encyclopedia/encyclopedia-screenshots.spec.ts e2e/docs/help/forex-help-screenshots.spec.ts e2e/docs/help/onboarding-help-screenshots.spec.ts e2e/docs/help/sales-shop-help-screenshots.spec.ts e2e/docs/help/stock-exchange-help-screenshots.spec.ts",
    "i18n:missing": "node scripts/find-missing-translation-keys.mjs",
    "i18n:template-missing": "node scripts/find-missing-template-translation-keys.mjs",
    "type-check": "vue-tsc --build",
    "check-typescript-errors-tsc": "npx tsc --noEmit --project tsconfig.app.json",
    "check-typescript-errors-vue": "npx vue-tsc --noEmit --project tsconfig.app.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@sentry/vue": "^11.7.0",
    "country-flag-icons": "^1.6.20",
    "dompurify": "^3.4.17",
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "unique-names-generator": "^4.7.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.88.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.1",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.88.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
