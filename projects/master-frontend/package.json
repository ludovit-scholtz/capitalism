{
  "name": "capitalism-master-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "run-s type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview --port 4174",
    "test:unit": "vitest run",
    "test:security-headers": "node scripts/verify-security-headers.mjs",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@sentry/vue": "^11.7.0",
    "country-flag-icons": "^1.6.20",
    "dompurify": "^3.4.17",
    "easymde": "^2.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.88.0",
    "eslint-plugin-vue": "~10.11.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
